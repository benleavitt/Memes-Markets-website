# Twitch live status (Phase 3). Client-credentials app token.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_USER_LOGIN=memesandmarkets

# Force the player into its live state for demos, and as a fallback if Twitch is down.
FORCE_LIVE=false

# Substack newsletter. Only needed if the publication moves off its current
# custom domain — lib/newsletter.ts defaults to https://www.memesandmarkets.com.
SUBSTACK_PUBLICATION_URL=
