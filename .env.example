# Twitch live status (Phase 3). Client-credentials app token.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_USER_LOGIN=memesandmarkets

# Force the player into its live state for demos, and as a fallback if Twitch is down.
FORCE_LIVE=false

# Substack newsletter. Only needed if the publication moves off its current
# custom domain — lib/newsletter.ts defaults to https://www.memesandmarkets.com.
SUBSTACK_PUBLICATION_URL=

# The audience numbers on the landing page. WITHOUT THIS THEY DO NOT UPDATE:
# lib/stats.ts serves content/channel-stats-fallback.json instead, which is real
# but frozen at whenever it was last committed. Free and read-only — enable
# "YouTube Data API v3" at console.cloud.google.com and create an API key.
# Restrict it to that one API; it needs no other scope and no OAuth.
YOUTUBE_API_KEY=

# Partnership enquiries -> Google Sheet. See scripts/partner-sheet.gs for the
# five-minute setup; the /exec URL it gives you goes here. Without it /api/partner
# answers 503 and tells people to email instead, rather than pretending to file
# an enquiry nobody will read.
PARTNER_SHEET_WEBHOOK=
# Must match SHARED_SECRET inside the Apps Script. The web app has to be open to
# "Anyone" for Vercel to reach it, so this is what stops a leaked URL becoming a
# spam funnel into the sheet.
PARTNER_SHEET_SECRET=

# Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX. NEXT_PUBLIC_ because the
# tag runs in the browser; it is not a secret — anyone can read it in the page
# source of any site using GA. Without it, no analytics script loads at all and
# the cookie banner still appears (it is asking about GA, which is the only thing
# on the site that would set a cookie), so leave it unset until you want data.
NEXT_PUBLIC_GA_ID=

# Google Search Console, meta-tag verification. Only the token from the
# "HTML tag" method — the bare content value, not the whole <meta> element.
# The DNS TXT method needs nothing here and survives a change of host, so prefer
# it if the domain is yours to edit.
NEXT_PUBLIC_GSC_VERIFICATION=
