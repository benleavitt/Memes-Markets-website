# dependencies
node_modules/
.pnp
.pnp.*

# build output
.next/
out/
build/
dist/
.swc/

# generated
*.tsbuildinfo
next-env.d.ts
.vercel/

# test artifacts
coverage/
playwright-report/
test-results/
blob-report/
.playwright/

# env — never commit secrets (TWITCH_CLIENT_ID, TWITCH_CLIENT_SECRET, etc.)
#
# Deliberately `.env.*` rather than only `.env*.local`: the old pattern let a
# plain `.env.production` through, which is precisely the file most likely to
# hold a real Substack or Twitch credential. Only the example is allowed back in.
.env
.env.*
!.env.example

# credentials that are never project files, wherever they land
*.pem
*.key
*.p12

# logs
*.log
npm-debug.log*
yarn-error.log*

# agent and editor state — local to whoever is sitting here, not part of the app
#
# `.claude/*` rather than `.claude/`, so a shared project config can still be
# committed by adding it to the exceptions below. Everything else in there is
# machine-local: gstack is installed globally rather than vendored, launch.json
# points at one person's dev server, settings.local.json is per-user permissions.
.claude/*
!.claude/settings.json
.gstack/
.vscode/
.idea/

# os
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*~

# local-only: routes npm scripts through bash so an "&" in the repo path
# does not break .bin shims under cmd. Delete once the folder is renamed.
.npmrc
